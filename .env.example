# KingdeeMCP lightweight service environment example.
# Copy to .env on the server and fill real values. Do not commit .env.

# KINGDEE_SERVER_URL: Kingdee K/3 Cloud WebAPI base URL. It must include the /k3cloud/ suffix.
KINGDEE_SERVER_URL=https://your-kingdee-host/k3cloud/

# KINGDEE_ACCT_ID: Kingdee account set id used by LoginByAppSecret.
KINGDEE_ACCT_ID=your_acct_id

# KINGDEE_APP_ID: Third-party system application id created in Kingdee admin.
KINGDEE_APP_ID=your_app_id

# KINGDEE_APP_SEC: Third-party system application secret. Treat as a server-side secret.
KINGDEE_APP_SEC=your_app_secret

# KINGDEE_LCID: Kingdee locale id. 2052 is Simplified Chinese.
KINGDEE_LCID=2052

# KINGDEE_USERNAME: Optional fallback user for local stdio, --check, or MCP_AUTH_DISABLED=true tests.
# In production HTTP mode, leave this empty and map users through MCP_TOKEN_CONFIG.
KINGDEE_USERNAME=

# KINGDEE_SESSION_TTL_SECONDS: How long to reuse one Kingdee login before proactive relogin.
# 1200 seconds avoids stale long-idle sessions; set 0 only if you intentionally want no TTL.
KINGDEE_SESSION_TTL_SECONDS=1200

# MCP_TRANSPORT: Use streamable-http for the lightweight HTTP gateway; use stdio only for local testing.
MCP_TRANSPORT=streamable-http

# MCP_HOST: Bind the MCP origin to localhost for security. Cloudflared should connect to this local origin.
MCP_HOST=127.0.0.1

# MCP_PORT: Local-only MCP origin port. Current production recommendation is 8199.
MCP_PORT=8199

# MCP_PATH: HTTP path for JSON-RPC MCP requests.
MCP_PATH=/mcp

# MCP_TOKEN_CONFIG: Path to the Bearer token hash mapping file. Do not store plaintext tokens here.
MCP_TOKEN_CONFIG=/public/KingdeeMCP/secrets/tokens.json

# MCP_AUTH_DISABLED: Set true only for local unauthenticated tests. Keep false in production.
MCP_AUTH_DISABLED=false

# MCP_MAX_CONCURRENT_TOOLS: Maximum concurrent MCP tool handlers in this process.
MCP_MAX_CONCURRENT_TOOLS=8

# MCP_MAX_CONCURRENT_KINGDEE_REQUESTS: Maximum concurrent outbound Kingdee WebAPI requests.
MCP_MAX_CONCURRENT_KINGDEE_REQUESTS=4

# MCP_TOOL_QUEUE_TIMEOUT_SECONDS: How long a tool call waits for a concurrency slot before server_busy.
MCP_TOOL_QUEUE_TIMEOUT_SECONDS=15

# MCP_TOOL_CALL_TIMEOUT_SECONDS: Maximum wall-clock time for one tool call before timeout wrapping.
MCP_TOOL_CALL_TIMEOUT_SECONDS=120

# MCP_HTTP_REQUEST_QUEUE_SIZE: TCP accept backlog for the local HTTP server.
MCP_HTTP_REQUEST_QUEUE_SIZE=128

# MCP_CORS_ALLOW_ORIGINS: Browser/WebView clients need CORS. Use * for broad compatibility,
# or a comma-separated allowlist such as http://localhost:6274,https://your-client.example.com.
MCP_CORS_ALLOW_ORIGINS=*
